# Production environment variables for DevIntel AI
# Copy this to .env.production and fill in all values before deploying.
# NEVER commit .env.production to version control.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=devintel
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=devintel_db
DATABASE_URL=postgresql+asyncpg://devintel:CHANGE_ME_STRONG_PASSWORD@postgres:5432/devintel_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# ── Application Security ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_HEX_SECRET
JWT_SECRET_KEY=CHANGE_ME_ANOTHER_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_FERNET_KEY

# ── GitHub OAuth (from https://github.com/settings/developers) ───────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# ⚠ Must point to the BACKEND callback endpoint, NOT the frontend!
# The backend exchanges the code, then redirects to FRONTEND_URL/oauth/callback
GITHUB_REDIRECT_URI=https://your-backend-domain.com/api/v1/auth/github/callback

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
CORS_ORIGINS=https://yourdomain.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Where the frontend is hosted — used for OAuth redirect after auth completes
FRONTEND_URL=https://yourdomain.com

# ── App Settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_NAME=DevIntel AI
LOG_LEVEL=WARNING
LOG_FORMAT=json
