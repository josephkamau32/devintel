# ==========================================
# PRODUCTION DEPLOYMENT
# ==========================================

# Production secrets - never commit these
.env.production

# Nginx SSL certificates
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt

# Nginx logs
nginx/logs/

# Database backup files
backups/

# ==========================================
# DEBUG & TEST OUTPUT FILES
# ==========================================
# These should NEVER be committed — use .gitignore to prevent it

# Catch-all patterns for test/debug output
*_out.txt
*_out_*.txt
*_output.txt
*_output_*.txt
*error*.txt
*err*.txt
api_logs.txt
lint-results*.json
lint_out*.txt
pytest_*.txt
test_output*.txt
*test_output*.txt

# Backend specifics
devintel-backend/test_result*.log
devintel-backend/verify_*.py

# Frontend specifics
devintel-frontend/*.log
devintel-frontend/lint_*.txt
devintel-frontend/err.*

# ==========================================
# SCRATCH / PLANNING FILES
# ==========================================
phase2_only.txt
phase2_spec.txt
phase2_spec_utf8.txt
prompt.txt

# Bun lockfiles (project uses npm)
bun.lock
bun.lockb
devintel-frontend/bun.lockb

