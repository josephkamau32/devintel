# ROOT LEVEL
# ==========================================

# Logs
logs
*.log

# Backend temporary
src/test/

# ==========================================
# GLOBAL
# ==========================================

# Python bytecode (global)
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/

# Docker
docker-compose.override.yml

# Backup files
*.bak
*.backup
*~

# Editor
