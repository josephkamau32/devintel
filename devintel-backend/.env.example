# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/devintel

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_ME_32_CHAR_HEX
SECRET_KEY=REPLACE_ME_32_CHAR_HEX

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# ── Optional ─────────────────────────────────────────────────────────────────
DEBUG=true
