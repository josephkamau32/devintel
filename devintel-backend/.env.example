# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Environment (development, staging, production)
# WARNING: Set to 'production' for production deployments!
ENVIRONMENT=development

# Application Name
APP_NAME=DevIntel AI

# Debug Mode (MUST be false in production!)
# WARNING: Debug mode exposes sensitive information. NEVER use in production!
DEBUG=true

# API Prefix
API_V1_PREFIX=/api/v1

# ==========================================
# SERVER CONFIGURATION
# ==========================================

HOST=0.0.0.0
PORT=8000
WORKERS=4

# ==========================================
# SECURITY
# ==========================================

# Secret Key for application security
# CRITICAL: Generate with: openssl rand -hex 32
# WARNING: Change this in production! Keep it SECRET!
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Secret Key for token signing
# CRITICAL: Generate with: openssl rand -hex 32
# WARNING: Different from SECRET_KEY! Keep it SECRET!
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
# Token expiration in minutes (15 minutes for better security)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token expiration in days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Token Encryption Key for storing GitHub OAuth tokens
# CRITICAL: Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Keep this SECRET! Used to encrypt/decrypt GitHub tokens in database!
TOKEN_ENCRYPTION_KEY=your-token-encryption-key-change-in-production

# ==========================================
# DATABASE
# ==========================================

# PostgreSQL Connection String
# Format: postgresql+asyncpg://user:password@host:port/database
# For Docker: use service name 'postgres' as host
# For production: use fully qualified hostname
DATABASE_URL=postgresql+asyncpg://devintel:devintel@postgres:5432/devintel_db

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# ==========================================
# REDIS (Cache & Queue)
# ==========================================

# Redis Connection URL
# For Docker: use service name 'redis' as host
REDIS_URL=redis://redis:6379/0

# Cache TTL in seconds (3600 = 1 hour)
REDIS_CACHE_TTL=3600

# ==========================================
# CELERY (Background Tasks)
# ==========================================

# Use different Redis databases for broker and results
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==========================================
# GITHUB OAUTH
# ==========================================

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth Callback URL (must match GitHub app settings)
# For local dev: http://localhost:8080/auth/callback
# For production: https://yourdomain.com/auth/callback
GITHUB_REDIRECT_URI=http://localhost:8080/auth/callback

# ==========================================
# OPENAI API
# ==========================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# WARNING: Keep this SECRET! Never commit to version control!
OPENAI_API_KEY=your-openai-api-key

# Embedding Model (384-3072 dimensions available)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat Model for RAG responses
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# Maximum tokens for chat responses
OPENAI_MAX_TOKENS=4096

# ==========================================
# CORS (Cross-Origin Resource Sharing)
# ==========================================

# Allowed Origins (comma-separated)
# For production: specify exact domains, e.g., https://app.devintel.ai,https://devintel.ai
# WARNING: Never use '*' in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Allow credentials (cookies, auth headers)
CORS_ALLOW_CREDENTIALS=true

# ==========================================
# RATE LIMITING
# ==========================================

# Requests per minute per IP
# Adjust based on your needs (100 is reasonable for development)
RATE_LIMIT_PER_MINUTE=100

# ==========================================
# RAG CONFIGURATION
# ==========================================

# Chunk size in tokens (500-1000 recommended)
# Larger = more context per chunk but fewer chunks
CHUNK_SIZE=700

# Overlap between chunks in tokens (100-200 recommended)
# Prevents context loss at chunk boundaries
CHUNK_OVERLAP=120

# Number of most relevant chunks to retrieve for RAG
# 3-10 recommended (balance between context and noise)
TOP_K_CHUNKS=6

# Vector embedding dimensions (must match embedding model)
# text-embedding-3-small: 1536 dimensions
EMBEDDING_DIMENSIONS=1536

# ==========================================
# INDEXING CONFIGURATION
# ==========================================

# Supported file extensions for indexing (comma-separated)
# Add or remove as needed for your use case
SUPPORTED_FILE_EXTENSIONS=.py,.js,.ts,.tsx,.jsx,.java,.go,.rs,.rb,.md,.json,.yaml,.yml,.c,.cpp,.h,.hpp,.cs,.php,.swift,.kt

# Directories to ignore during indexing (comma-separated)
IGNORED_DIRECTORIES=node_modules,.git,dist,build,venv,.venv,__pycache__,.pytest_cache,.next,out,target,vendor

# Maximum file size to index (in MB)
# Files larger than this will be skipped
MAX_FILE_SIZE_MB=10

# ==========================================
# LOGGING
# ==========================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Use DEBUG for development, INFO or WARNING for production
LOG_LEVEL=INFO

# Log Format (text or json)
# Use 'json' for production (easier to parse in log aggregation tools)
LOG_FORMAT=json

# ==========================================
# MONITORING & OBSERVABILITY (Optional)
# ==========================================

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io/
# Leave empty to disable Sentry
SENTRY_DSN=

# Sentry Environment Name
SENTRY_ENVIRONMENT=development

# Sentry Traces Sample Rate (0.0 to 1.0)
# 0.1 = 10% of requests tracked for performance monitoring
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==========================================
# PRODUCTION-SPECIFIC SETTINGS
# ==========================================

# Allowed Hosts (comma-separated, for production)
# Example: api.devintel.ai,devintel.ai
ALLOWED_HOSTS=localhost,127.0.0.1

# Enable HTTPS Redirect (true/false, enable in production)
HTTPS_REDIRECT=false

# ==========================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ==========================================
#
# 1. Set ENVIRONMENT=production
# 2. Set DEBUG=false
# 3. Generate new SECRET_KEY and JWT_SECRET_KEY using: openssl rand -hex 32
# 4. Use managed database (AWS RDS, DigitalOcean, etc.) and update DATABASE_URL
# 5. Use managed Redis (ElastiCache, Redis Cloud, etc.) and update REDIS_URL
# 6. Update CORS_ORIGINS to your production frontend domain(s)
# 7. Configure GITHUB_REDIRECT_URI to your production callback URL
# 8. Set strong GITHUB_CLIENT_SECRET (never reuse between environments)
# 9. Use production OPENAI_API_KEY with proper rate limits
# 10. Set ALLOWED_HOSTS to your production domain(s)
# 11. Enable HTTPS_REDIRECT=true
# 12. Configure SENTRY_DSN for error tracking
# 13. Set LOG_LEVEL=WARNING or ERROR to reduce noise
# 14. Ensure all secrets are stored in environment variables, NOT in code!
#
# ==========================================
