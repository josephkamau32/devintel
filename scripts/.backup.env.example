# DevIntel Backup Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devintel_db
DB_USER=devintel
DB_PASSWORD=your_db_password_here

# Backup Settings
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# Encryption (set a strong passphrase for GPG encryption)
BACKUP_ENCRYPTION_KEY=your_strong_encryption_passphrase_here

# Optional: AWS S3 Upload
# AWS_S3_BUCKET=your-backup-bucket
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1

# Backup Schedule (cron format)
# Example: Daily at 2 AM
# 0 2 * * * /path/to/scripts/backup_database.sh >> /var/log/devintel-backup.log 2>&1
